<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Thrust</RootNamespace>
    <AssemblyName>Thrust</AssemblyName>
    <Authors>StArray</Authors>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/StArraySharp/Thrust</PackageProjectUrl>
    <RepositoryUrl>https://github.com/StArraySharp/Thrust</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NVorbis" Version="1.0.0-rc.2" />
    <PackageReference Include="OpenAL.Soft" Version="1.23.1" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
  </ItemGroup>

  <!--
    OpenAL.Soft 的 props 依赖 $(PlatformTarget)，SDK 项目下该值为空导致原生 DLL 不会被复制。
    这里直接按 RID 复制，保证跨平台构建都能拿到 OpenAL32。
    OpenAL.Soft's props relies on $(PlatformTarget) which is empty for SDK projects,
    so copy the native DLL by RID here instead.
  -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)openal.soft\1.23.1\runtimes\win-x64\native\Release\OpenAL32.dll"
          Condition="Exists('$(NuGetPackageRoot)openal.soft\1.23.1\runtimes\win-x64\native\Release\OpenAL32.dll')"
          Link="OpenAL32.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>