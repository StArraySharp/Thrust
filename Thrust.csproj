<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Thrust</RootNamespace>
    <AssemblyName>Thrust</AssemblyName>
    <Authors>StArray</Authors>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/StArraySharp/Thrust</PackageProjectUrl>
    <RepositoryUrl>https://github.com/StArraySharp/Thrust</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NVorbis" Version="1.0.0-rc.2" />
    <!--
      The native asset list of this package carries both Debug and Release copies of OpenAL32,
      including the import libraries. A single-file publish then fails with NETSDK1152 because the
      two .lib files share a relative path. Native assets are excluded here and OpenAL32.dll is
      copied explicitly below, which is the only file the runtime needs.
      包里的原生资源同时带 Debug/Release 两份 OpenAL32（含导入库 .lib），单文件发布时相对路径
      冲突。这里排除原生资源，改为在下面显式复制运行时真正需要的 OpenAL32.dll。
    -->
    <PackageReference Include="OpenAL.Soft" Version="1.23.1" ExcludeAssets="native" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
  </ItemGroup>

  <!--
    OpenAL.Soft 的 props 依赖 $(PlatformTarget)，SDK 项目下该值为空导致原生 DLL 不会被复制。
    这里直接按 RID 复制，保证跨平台构建都能拿到 OpenAL32。
    OpenAL.Soft's props relies on $(PlatformTarget) which is empty for SDK projects,
    so copy the native DLL by RID here instead.
  -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)openal.soft\1.23.1\runtimes\win-x64\native\Release\OpenAL32.dll"
          Condition="Exists('$(NuGetPackageRoot)openal.soft\1.23.1\runtimes\win-x64\native\Release\OpenAL32.dll')"
          Link="OpenAL32.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <!--
    openal.soft 的运行时包同时带 Debug 和 Release 两份 OpenAL32.lib，单文件发布时两者相对路径相同
    会触发 NETSDK1152。导入库只在链接阶段用得到，运行时不需要，从发布输出里剔除。
    The openal.soft runtime pack ships OpenAL32.lib for both Debug and Release; a single-file
    publish then fails with NETSDK1152 because they share a relative path. Import libraries are a
    link-time artefact, so drop them from the files that get published.
  -->
  <Target Name="DropOpenAlImportLibraries" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>

</Project>